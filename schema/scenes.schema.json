{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["scenes"],
  "properties": {
    "schema_version": {"type": "string"},
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "beat_id", "action", "visual_notes", "est_duration_sec", "shot_list"],
        "properties": {
          "id": {"type": "string"},
          "beat_id": {"type": "string"},
          "action": {"type": "string"},
          "visual_notes": {"type": "string"},
          "est_duration_sec": {"type": "number"},
          "shot_list": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["shot_id", "start", "end", "framing", "attention_subject", "action", "camera_move", "transition_in", "exit_state", "cinematic_design"],
              "properties": {
                "shot_id": {"type": "string"},
                "start": {"type": "number"},
                "end": {"type": "number"},
                "framing": {"type": "string"},
                "attention_subject": {"type": "string"},
                "action": {"type": "string"},
                "camera_move": {"type": "string"},
                "transition_in": {"type": "string"},
                "exit_state": {"type": "string"},
                "cinematic_design": {
                  "type": "object",
                  "required": ["narrative_job", "audience_knowledge", "composition_logic", "blocking_map", "performance_detail", "light_motivation", "event_budget"],
                  "properties": {
                    "narrative_job": {"type": "string"},
                    "audience_knowledge": {"type": "object"},
                    "composition_logic": {"type": "string"},
                    "blocking_map": {"type": "object"},
                    "performance_detail": {"type": "object"},
                    "light_motivation": {"type": "object"},
                    "event_budget": {"type": "object"}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
