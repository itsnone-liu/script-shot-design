{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "821 Script Case",
  "type": "object",
  "required": ["source_id", "source", "story", "beats"],
  "properties": {
    "source_id": {"type": "string"},
    "title": {"type": "string"},
    "source": {"type": "object", "required": ["status"], "properties": {"url": {"type": "string"}, "accessed_at": {"type": "string"}, "status": {"enum": ["ok", "blocked", "user_provided"]}}},
    "story": {"type": "object", "required": ["character_goal", "obstacle", "turning_choice", "result", "brand_role"], "properties": {"logline": {"type": "string"}, "theme": {"type": "string"}, "character_goal": {"type": "string"}, "obstacle": {"type": "string"}, "turning_choice": {"type": "string"}, "result": {"type": "string"}, "brand_role": {"type": "string"}}},
    "beats": {"type": "array", "items": {"type": "object", "required": ["id", "function", "visible_action", "state_in", "state_out"], "properties": {"id": {"type": "string"}, "function": {"type": "string"}, "visible_action": {"type": "string"}, "state_in": {"type": "string"}, "state_out": {"type": "string"}, "evidence": {"type": "string"}}}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
